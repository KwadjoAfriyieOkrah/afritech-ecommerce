# Copy this file to .env.test and set test-only PostgreSQL credentials.
# The database name must remain afritech_backend_test.
DATABASE_URL_TEST=postgresql://test_user:test_password@localhost:5433/afritech_backend_test

# Test-only signing secret; generate a random value of at least 32 characters.
JWT_SECRET_TEST=

# Use a Paystack test-mode key only. Integration tests must never use sk_live_*.
PAYSTACK_SECRET_KEY_TEST=sk_test_local_placeholder_not_a_real_key
