generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum FulfillmentStatus {
  PENDING
  PACKAGING
  DISPATCHED
  DELIVERED
}

enum InventoryReason {
  ORDER
  RESTOCK
  ADJUSTMENT
}

enum ProductCategory {
  IPHONE
  SAMSUNG
  LAPTOP
}

enum PaymentAttemptStatus {
  INITIALIZED // reference minted; no trusted provider outcome recorded yet
  SUCCEEDED   // provider-confirmed success, amount/currency validated
  FAILED      // definitive provider-reported failure only (never a timeout)
  ABANDONED   // superseded, cancelled, or reservation released; still resolvable
  MISMATCH    // provider success whose amount/currency failed validation
}

enum RefundStatus {
  NONE
  PENDING
  REFUNDED
  REJECTED
}

enum ReconciliationReason {
  UNKNOWN_REFERENCE
  ORDER_MISSING
  DUPLICATE_CHARGE
  PAYMENT_AFTER_EXPIRY
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  UNEXPECTED
}

enum ReconciliationStatus {
  PENDING
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
  rider        Rider?
  adminLogs    AdminLog[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String           // Apple, Samsung, etc.
  category    ProductCategory  // iPhone, Samsung, Laptop
  description String?
  specs       Json?
  basePrice   Decimal  @db.Decimal(10, 2)
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  colors      Color[]
  orderItems  OrderItem[]
  dailySales  DailySale[]
}

model Color {
  id        String   @id @default(cuid())
  productId String
  name      String
  hex       String?
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@unique([productId, name])
  @@index([productId])
}

model Order {
  id              String            @id @default(cuid())
  reference       String            @unique // productId + date + time, used for admin filtering and rider assignment
  userId          String?           // null for guest checkout
  customerName    String
  customerEmail   String?
  accessTokenHash String?
  customerPhone   String
  region          String            // Greater Accra, other regions, etc.
  address         String
  deliveryFee     Decimal           @db.Decimal(10, 2)
  total           Decimal           @db.Decimal(10, 2)
  paymentStatus   PaymentStatus     @default(PENDING)
  fulfillment     FulfillmentStatus @default(PENDING)
  paystackRef     String?           @unique // enforces idempotency on webhooks
  paidAt          DateTime?
  riderId         String?
  reservedUntil   DateTime?         // set on creation; null once paid or released
  deliveredAt     DateTime?
  idempotencyKey  String?           @unique // client-generated per checkout attempt
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user                User?                @relation(fields: [userId], references: [id])
  rider               Rider?               @relation(fields: [riderId], references: [id])
  items               OrderItem[]
  inventory           InventoryLog[]
  dailySales          DailySale[]
  paymentAttempts     PaymentAttempt[]
  reconciliation       ReconciliationEntry[]

  @@index([paymentStatus, createdAt])
  @@index([fulfillment])
  @@index([riderId])
}

model PaymentAttempt {
  id                    String                @id @default(cuid())
  orderId               String
  reference             String                @unique
  amountPesewas         BigInt
  currency              String                @default("GHS")
  status                PaymentAttemptStatus  @default(INITIALIZED)
  refundStatus          RefundStatus          @default(NONE)
  reconciliationReason  ReconciliationReason?
  providerAmountPesewas BigInt?
  providerCurrency      String?
  providerTransactionId String?
  confirmedAt           DateTime?
  reconciledAt          DateTime?
  reconciliationNote    String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reconciliation ReconciliationEntry?

  @@index([orderId])
  @@index([status])
  @@index([refundStatus])
}

// Durable inbox for captured-but-unfulfillable payments and unmatched provider
// events. Rows are never deleted by the app; operators resolve them explicitly.
model ReconciliationEntry {
  id                    String               @id @default(cuid())
  orderId               String?
  attemptId             String?              @unique
  reference             String
  reason                ReconciliationReason
  amountPesewas         BigInt?
  providerCurrency      String?
  providerTransactionId String?
  status                ReconciliationStatus @default(PENDING)
  resolution            String?
  note                  String?
  resolvedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attempt PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([reference, reason])
  @@index([status])
  @@index([createdAt])
  @@index([orderId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  colorId   String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  color   Color   @relation(fields: [colorId], references: [id])

  @@index([orderId])
}

model Rider {
  id        String   @id @default(cuid())
  name      String
  phone     String
  userId    String?  @unique // optional login for the delivery role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([createdAt])
}

model InventoryLog {
  id        String          @id @default(cuid())
  colorId   String
  change    Int
  reason    InventoryReason
  orderId   String?
  note      String?
  createdAt DateTime        @default(now())

  color Color  @relation(fields: [colorId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([colorId, createdAt])
}

model DeliveryZone {
  id           String   @id @default(cuid())
  name         String   @unique // "Accra", "Tema", "Kumasi", "Cape Coast", "Tamale", "Other regions"
  fee          Decimal  @db.Decimal(10, 2)
  expectedDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One row per UTC day, used to allocate sequential order numbers for that day.
model OrderCounter {
  id         String   @id @default(cuid())
  date       DateTime @db.Date @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Written once per paid order item and never updated or deleted by the app.
model DailySale {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  saleDate  DateTime @db.Date
  quantity  Int
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleDate])
  @@index([productId, saleDate])
}
