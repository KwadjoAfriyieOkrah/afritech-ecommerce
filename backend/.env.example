# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/afritech
DATABASE_URL=

# HTTP port the Express server binds to
PORT=4000

# Exact browser origin allowed by CORS and the mutation origin check
FRONTEND_URL=http://localhost:3000

# Local Redis connection URL
REDIS_URL=redis://127.0.0.1:6379

# Set to the verified X-Forwarded-For proxy hop count in production; keep 0 locally
TRUST_PROXY_HOPS=0

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=

# Paystack secret key (sk_test_... or sk_live_...). Server-side only.
PAYSTACK_SECRET_KEY=